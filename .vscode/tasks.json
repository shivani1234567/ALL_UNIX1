{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build POSIX Pthread (C)",
            "type": "shell",
            "command": "/usr/bin/gcc",
            "args": [
                "-pthread",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run POSIX Pthread (C)",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
